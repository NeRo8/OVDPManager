rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // One backup per Google account, already encrypted with the user's key on the device.
    // Only that account, signed in with Google, may read, replace or delete it; nothing can list
    // the collection, and everything outside it stays closed.
    match /backups/{uid} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true;
      }

      // The app writes exactly these fields: the backup file as text and when it was made.
      function isValidBackup(data) {
        return data.keys().hasAll(['email', 'exportedAt', 'backup'])
          && data.keys().hasOnly(['email', 'exportedAt', 'backup'])
          && data.email == request.auth.token.email
          && data.exportedAt is string
          && data.exportedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
          && data.backup is string
          && data.backup.size() < 900000;
      }

      allow get, delete: if isOwner();
      allow create, update: if isOwner() && isValidBackup(request.resource.data);
    }
  }
}
