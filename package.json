{
  "name": "ovdpmanager",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.22.1"
  },
  "main": "index.ts",
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-firebase/app": "27.0.0",
    "@react-native-firebase/auth": "27.0.0",
    "@react-native-firebase/firestore": "27.0.0",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-unistyles": "^3.5.3",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/shared/ui$": "<rootDir>/jest.sharedUiStub.ts",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "steiger": "^0.8.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:fsd": "steiger ./src",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "yarn format:check && yarn lint && yarn lint:fsd && yarn typecheck && yarn test",
    "prepare": "husky",
    "build:dev:ios": "npx eas-cli build --platform ios --profile development",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:ios:submit": "npx eas-cli build --platform ios --profile production --auto-submit --no-wait",
    "build:local:ios": "npx eas-cli build --platform ios --profile production --local"
  },
  "private": true
}
