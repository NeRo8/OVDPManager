{
  "expo": {
    "name": "ОВДП Портфель",
    "slug": "ovdpmanager",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./src/shared/config/app-icon/icon.png",
    "scheme": "ovdpmanager",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#046865",
    "ios": {
      "icon": "./src/shared/config/app-icon/icon.png",
      "bundleIdentifier": "com.nero.mobile.dev.ovdpmanager",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "uk",
        "CFBundleLocalizations": ["uk"]
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": { "usesNonExemptEncryption": true }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#046865",
        "foregroundImage": "./src/shared/config/app-icon/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nero.mobile.dev.ovdpmanager",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#046865",
          "image": "./src/shared/config/app-icon/splash-blank.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "./plugins/withDatePickerAccent",
        {
          "accent": { "light": "#046865", "dark": "#21A0A0" },
          "header": { "background": "#046865", "text": "#FCFFF7", "mutedText": "#CCFCFFF7" }
        }
      ],
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      "react-native-quick-crypto",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      ["expo-build-properties", { "ios": { "useFrameworks": "dynamic" } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": { "projectId": "2f3d3beb-9ce7-43bf-93c4-20d6a0125624" }
    },
    "owner": "nero8"
  }
}
