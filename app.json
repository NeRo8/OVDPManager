{
  "expo": {
    "name": "OVDPManager",
    "slug": "OVDPManager",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./src/shared/config/app-icon/icon.png",
    "scheme": "ovdpmanager",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#046865",
    "ios": {
      "icon": "./src/shared/config/app-icon/icon.png",
      "bundleIdentifier": "com.arturduchenkoomnitelecom.OVDPManager",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "uk",
        "CFBundleLocalizations": ["uk"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#046865",
        "foregroundImage": "./src/shared/config/app-icon/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arturduchenkoomnitelecom.OVDPManager"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#046865",
          "image": "./src/shared/config/app-icon/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "./plugins/withDatePickerAccent",
        {
          "accent": { "light": "#046865", "dark": "#21A0A0" },
          "header": { "background": "#046865", "text": "#FCFFF7", "mutedText": "#CCFCFFF7" }
        }
      ],
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
