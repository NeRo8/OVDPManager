{
  "expo": {
    "name": "OVDPManager",
    "slug": "OVDPManager",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./src/shared/config/app-icon/icon.png",
    "scheme": "ovdpmanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/shared/config/app-icon/expo.icon",
      "bundleIdentifier": "com.arturduchenkoomnitelecom.OVDPManager"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/shared/config/app-icon/android-icon-foreground.png",
        "backgroundImage": "./src/shared/config/app-icon/android-icon-background.png",
        "monochromeImage": "./src/shared/config/app-icon/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arturduchenkoomnitelecom.OVDPManager"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./src/shared/config/app-icon/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
