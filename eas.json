{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "node": "24.22.1",
      "yarn": "1.22.22",
      "ios": {
        "cocoapods": "1.16.2"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826422237",
        "appleTeamId": "W25YBRT2T2",
        "metadataPath": "./store.config.js"
      }
    }
  }
}
